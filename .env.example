# Скопируйте в .env и впишите свои значения. Файл .env в git НЕ попадает.
TELEGRAM_BOT_TOKEN=your-telegram-token

# Все обращения к OpenAI (чат и эмбеддинги) идут через OPENAI_BASE_URL (ProxyAPI)
OPENAI_API_KEY=your-proxyapi-key
OPENAI_BASE_URL=https://api.proxyapi.ru/openai/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

PINECONE_API_KEY=your-pinecone-key
PINECONE_INDEX_NAME=haystack-assistant-v2
PINECONE_NAMESPACE=assistant
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Необязательно
# CONTEXT_TOP_K=5
# DOCS_TOP_K=5
# CHUNK_MAX_TOKENS=512
# DOCLING_DO_OCR=true
# MAX_FILE_MB=20
